# Naver CLOVA Studio API 키 정보 (대본 생성용)
HCX_API_KEY=여기에_API_KEY를_붙여넣으세요

# ETRI 오픈 API 키 (단어 분석용)
ETRI_API_KEY=여기에_ETRI_API_KEY를_붙여넣으세요

# MS Azure Speech API 키 정보 (발음 평가용)
AZURE_SPEECH_KEY=여기에_AZURE_KEY를_붙여넣으세요
AZURE_SPEECH_REGION=koreacentral

# Naver Clova Voice API 키 정보 (음성 합성/TTS용)
CLOVA_VOICE_CLIENT_ID=여기에_CLOVA_VOICE_CLIENT_ID를_붙여넣으세요
CLOVA_VOICE_CLIENT_SECRET=여기에_CLOVA_VOICE_CLIENT_SECRET을_붙여넣으세요

# Naver CLOVA OCR 키 정보 (PPT 안 이미지 텍스트 추출용)
CLOVA_OCR_SECRET_KEY=여기에_CLOVA_OCR_SECRET_KEY를_붙여넣으세요
CLOVA_OCR_INVOKE_URL=여기에_CLOVA_OCR_INVOKE_URL을_붙여넣으세요
